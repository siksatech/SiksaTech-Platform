{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@siksatech/ui": ["./packages/ui/src/*"],
      "@siksatech/auth": ["./packages/auth/src/*"],
      "@siksatech/database": ["./packages/database/src/*"],
      "@siksatech/config": ["./packages/config/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "apps/**/*",
    "packages/**/*"
  ],
  "exclude": ["node_modules"]
}
